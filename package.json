{
  "name": "zool-theme",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, refined theme for Komari and Nezha server monitors, by ZOOL.",
  "license": "MIT",
  "homepage": "https://github.com/foru17/zool-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foru17/zool-theme.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "vite --mode komari",
    "dev:nezha": "vite --mode nezha",
    "dev:demo": "vite --mode demo",
    "build": "pnpm build:komari && pnpm build:nezha",
    "build:komari": "vite build --mode komari",
    "build:nezha": "vite build --mode nezha",
    "package": "node scripts/package.mjs",
    "icons:os": "node scripts/import-os-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:i18n"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "simple-icons": "16.31.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
